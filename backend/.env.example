# HealthSense backend configuration
# Copy this file to backend/.env and replace placeholders as needed.
DATABASE_URL=sqlite:///C:/path/to/healthcare/backend/healthsense.db
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
